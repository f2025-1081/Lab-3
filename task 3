#include <iostream>
using namespace std;
int main()
{
    int totalSeconds = 4564;
    int minutes = totalSeconds / 60;
    int seconds = totalSeconds % 60;

    cout << "Total Seconds: " << totalSeconds << endl;
    cout << "Equivalent Time: " << minutes << " minutes and " << seconds << " seconds." << endl;


    return 0;
}
